# AirAccount online KMS (T1.1). Process never holds ISSUER_PRIVATE_KEY.
KMS_URL=https://kms.aastar.io
KMS_API_KEY=
KMS_KEY_ID=
KMS_ISSUER_ADDRESS=
# Automated issuer: create-agent-key once, then JWT. Required (no WebAuthn in this client).
# Path must be m/44'/60'/0'/1/{agentIndex}.
KMS_AGENT_JWT=
KMS_HD_PATH=m/44'/60'/0'/1/0

# Independent verifier process (T1.5 process split). Issuer injects HttpVerifier({ url, token }).
VERIFIER_URL=http://127.0.0.1:8787
VERIFIER_HOST=127.0.0.1
VERIFIER_PORT=8787
VERIFIER_SET=vericommons-verifier
VERIFIER_TOKEN=
